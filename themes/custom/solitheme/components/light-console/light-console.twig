{#
  @component light-console
  Interactive grandMA3-style light table. The stage above the console reacts
  live to the faders and buttons below.

  @prop string  eyebrow      - Mono label above the heading
  @prop string  title        - Heading first part
  @prop string  title_accent - Heading accented part
  @prop integer fixtures     - Number of beams / channels (default: 6)
  @prop array   colors       - Palette for the color buttons

  Usage:
    {{ include('solitheme:light-console', {
      eyebrow: 'HANDS ON',
      title: 'TRY THE',
      title_accent: 'CONSOLE',
    }) }}
#}

{% set fixture_count = fixtures|default(6) %}
{% set palette = colors|default(['#ff9500', '#ff3d9a', '#00c8ff', '#bf5fff', '#39ff14', '#ffffff']) %}

<section
  class="light-console"
  data-fixtures="{{ fixture_count }}"
  data-colors="{{ palette|json_encode }}"
>
  <div class="light-console__container">
    {% if title %}
      {{ include('solitheme:section-header', {
        eyebrow: eyebrow|default('HANDS ON'),
        title: title,
        title_accent: title_accent,
      }) }}
    {% endif %}

    <div class="light-console__rig">
      {# Stage viewport — beams are generated by JS. #}
      <div class="light-console__stage" data-stage aria-hidden="true">
        <div class="light-console__truss"></div>
        <div class="light-console__floor"></div>
      </div>

      {# Console surface. #}
      <div class="light-console__desk">
        <div class="light-console__channels" data-channels></div>

        <div class="light-console__master">
          <p class="light-console__master-label">{{ 'MASTER'|t }}</p>

          <div class="light-console__master-sliders">
            <label class="light-console__fader-block">
              <span class="light-console__fader-name">{{ 'GRAND'|t }}</span>
              <span class="light-console__fader-frame light-console__fader-frame--short"><input type="range" class="light-console__fader" data-master min="0" max="100" value="80"
                aria-label="{{ 'Master intensity'|t }}" /></span>
            </label>
            <label class="light-console__fader-block">
              <span class="light-console__fader-name">{{ 'TILT'|t }}</span>
              <span class="light-console__fader-frame light-console__fader-frame--short"><input type="range" class="light-console__fader" data-tilt min="-40" max="40" value="0"
                aria-label="{{ 'Beam tilt'|t }}" /></span>
            </label>
          </div>

          <div class="light-console__master-buttons">
            <button type="button" class="light-console__key light-console__key--flash" data-flash>{{ 'FLASH'|t }}</button>
            <button type="button" class="light-console__key" data-strobe aria-pressed="false">{{ 'STROBE'|t }}</button>
            <button type="button" class="light-console__key" data-chase aria-pressed="false">{{ 'CHASE'|t }}</button>
            <button type="button" class="light-console__key light-console__key--blackout" data-blackout aria-pressed="false">{{ 'BLACKOUT'|t }}</button>
          </div>

          <p class="light-console__readout" data-readout>{{ 'READY — GRAND 80%'|t }}</p>
        </div>
      </div>
    </div>
  </div>
</section>
